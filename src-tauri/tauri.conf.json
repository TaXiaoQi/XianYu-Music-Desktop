{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "弦予音乐",
  "mainBinaryName": "弦予音乐",
  "version": "1.1.2-beta6",
  "identifier": "com.xymusic.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "弦予音乐",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self' ipc: http://localhost:1420; img-src 'self' asset: http://asset.localhost https://asset.localhost ms-appx-web: data: blob: https://*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' asset: http://asset.localhost https://asset.localhost data:; connect-src 'self' ipc: http://localhost:1420 ws://localhost:1420 https://api.github.com https://*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "copyright": "Copyright © 2026 XY-Music-Desktop Team",
    "shortDescription": "A beautiful local music player powered by Tauri.",
    "license": "AGPL-3.0-only",
    "fileAssociations": [
      {
        "ext": [
          "aac",
          "aif",
          "aiff",
          "flac",
          "m4a",
          "m4b",
          "mp3",
          "mp4",
          "oga",
          "ogg",
          "wav"
        ],
        "name": "XY-Music Audio",
        "description": "XY-Music Audio File",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    }
  }
}
